{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "smb-dlna",
  "version": "1.1.0",
  "description": "Samba (smb + nmb) und MiniDLNA: Status, Start/Stopp und Autostart (systemctl enable/disable) als Hermes-Tools, CLI, Dashboard-Tab und Desktop-Seite",
  "author": {
    "name": "sademar"
  },
  "homepage": "https://github.com/sademardotDE/smb-dlna",
  "license": "MIT",
  "keywords": [
    "samba",
    "smb",
    "dlna",
    "minidlna",
    "hermes",
    "hermes-desktop",
    "systemd",
    "service"
  ],
  "extensions": {
    "com.nousresearch.hermes": {
      "python_dependencies": [],
      "commands": [
        "services"
      ],
      "features": [
        "samba_control",
        "dlna_control",
        "service_management",
        "service_autostart"
      ]
    }
  }
}
